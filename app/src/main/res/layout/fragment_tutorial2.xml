<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFF3E0"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="32dp">

    <ImageView
        android:id="@+id/imgTutorial2"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/ic_info"
        app:tint="#E65100"
        android:contentDescription="Tutorial Icon 2" />

    <TextView
        android:id="@+id/tvTitleTutorial2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Notifikasi Langsung"
        android:textColor="#E65100"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvDescTutorial2"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:gravity="center"
        android:text="Dapatkan pemberitahuan langsung saat ada pesan masuk baru."
        android:textColor="#EF6C00"
        android:textSize="14sp" />

</LinearLayout>